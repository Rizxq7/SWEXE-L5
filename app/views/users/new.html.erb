
<h1>ユーザー登録</h1>

<% if flash[:alert] %>
  <p style="color: red;">
    <%= flash[:alert] %>
  </p>
<% end %>

<% if @user.errors.any? %>
  <ul style="color: red;">
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with url: users_path do |f| %>
  <p>
    ユーザーID
    <%= f.text_field :uid %>
  </p>

  <p>
    パスワード
    <%= f.password_field :password %>
  </p>

  <p>
    パスワード（確認）
    <%= f.password_field :password_confirmation %>
  </p>

  <p>
    年齢
    <%= f.number_field :age %>
  </p>

  <%= f.submit '登録' %>
<% end %>

<%= link_to '戻る', root_path %>
